import javafx.application.Application;
import javafx.scene.Scene;
import javafx.scene.control.Label;
import javafx.scene.image.Image;
import javafx.scene.image.ImageView;
import javafx.scene.layout.VBox;
import javafx.stage.Stage;
import java.io.InputStream;

public class DisplayTextAndImage extends Application {

    @Override
    public void start(Stage primaryStage) {
        Label textLabel = new Label("Hello, JavaFX!");

        // FIX: Load the image safely as a resource stream from your project folder
        // Ensure "imagePath.jpg" is placed inside your 'resources' or 'src' directory
        InputStream imageStream = getClass().getResourceAsStream("/imagePath.jpg");
        
        if (imageStream == null) {
            System.err.println("Error: Could not find imagePath.jpg in resources!");
            return;
        }

        Image image = new Image(imageStream);
        ImageView imageView = new ImageView(image);
        
        // Optional Best Practice: Preserves the aspect ratio so the image doesn't distort
        imageView.setPreserveRatio(true); 
        imageView.setFitWidth(400);
        imageView.setFitHeight(300);

        VBox vbox = new VBox(10);
        vbox.getChildren().addAll(textLabel, imageView);

        Scene scene = new Scene(vbox, 600, 400);
        primaryStage.setTitle("Text and Image Display");
        primaryStage.setScene(scene);
        primaryStage.show();
    }

    public static void main(String[] args) {
        launch(args);
    }
}
